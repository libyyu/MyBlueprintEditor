examples/CMakeFiles/basic-interaction-example.dir/rule: cmake_check_build_system
	$(CMAKE_COMMAND) -E cmake_progress_start /root/.openclaw/workspace/MyBlueprintEditor/build-linux/CMakeFiles 44
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 examples/CMakeFiles/basic-interaction-example.dir/all
	$(CMAKE_COMMAND) -E cmake_progress_start /root/.openclaw/workspace/MyBlueprintEditor/build-linux/CMakeFiles 0
.PHONY : examples/CMakeFiles/basic-interaction-example.dir/rule

# Convenience name for target.
basic-interaction-example: examples/CMakeFiles/basic-interaction-example.dir/rule
.PHONY : basic-interaction-example

# clean rule for target.
examples/CMakeFiles/basic-interaction-example.dir/clean:
	$(MAKE) $(MAKESILENT) -f examples/CMakeFiles/basic-interaction-example.dir/build.make examples/CMakeFiles/basic-interaction-example.dir/clean
.PHONY : examples/CMakeFiles/basic-interaction-example.dir/clean

#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	$(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

