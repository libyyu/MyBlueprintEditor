{
  "runtime": {
    "metadata": {
      "name": "AI_NPC_ShopKeeper",
      "description": "商店 NPC 对话蓝图：根据好感度推荐商品、折扣、发任务",
      "version": 1,
      "tags": ["minigame", "npc", "shop", "affinity"]
    },
    "variables": [
      {"name": "PlayerInput",    "type": "String", "value": ""},
      {"name": "Personality",    "type": "String", "value": "你是一家魔法道具店的猫头鹰老板，博学稳重，偶尔冷笑话。回复2-3句。"},
      {"name": "Affinity",       "type": "Float",  "value": 0},
      {"name": "PlayerName",     "type": "String", "value": "冒险者"},
      {"name": "PlayerGold",     "type": "Integer","value": 0},
      {"name": "PlayerLevel",    "type": "Integer","value": 1},
      {"name": "ShopItems",      "type": "String", "value": ""},
      {"name": "InventoryItems", "type": "String", "value": ""},
      {"name": "MeetCount",      "type": "Integer","value": 0},
      {"name": "KnownFacts",     "type": "String", "value": ""},
      {"name": "WorldTime",      "type": "String", "value": "白天"},
      {"name": "BaseURL",        "type": "String", "value": "https://open.bigmodel.cn/api/paas/v4"},
      {"name": "ApiKey",         "type": "String", "value": ""},
      {"name": "Model",          "type": "String", "value": "glm-4-flash"}
    ],
    "nodes": [
      {"id": 1, "definitionId": "OnExecute", "name": "Start"},

      {"id": 10, "definitionId": "GetVariable", "name": "Get PlayerInput",
       "nodeData": {"VariableName": "PlayerInput"}},
