       "nodeData": {"VariableName": "KnownFacts"}},

      {"id": 50, "definitionId": "GetVariable", "name": "Get BaseURL",
       "nodeData": {"VariableName": "BaseURL"}},
      {"id": 60, "definitionId": "GetVariable", "name": "Get ApiKey",
       "nodeData": {"VariableName": "ApiKey"}},
      {"id": 70, "definitionId": "GetVariable", "name": "Get Model",
       "nodeData": {"VariableName": "Model"}},

      {"id": 100, "definitionId": "FormatString", "name": "Build SystemPrompt",
       "pinValues": {
         "Format": "{0}\n\n== 状态 ==\n时间:{1} | 玩家:{2}(Lv.{3}) | 金币:{4} | 好感度:{5}/100 | 见面次数:{6}\n\n== 你的商品 ==\n{7}\n\n== 玩家背包 ==\n{8}\n\n== 你记得的事 ==\n{9}\n\n== 规则 ==\n- 好感度<30：态度冷淡，不打折\n- 好感度30-60：友好，偶尔推荐商品\n- 好感度>60：热情，主动打折，推荐稀有商品\n- 好感度>80：把玩家当朋友，分享秘密，给独家任务\n- 如果玩家要买东西，告诉价格让他确认\n- 如果玩家金币不够，温和提醒"
       }},

      {"id": 20, "definitionId": "JSON.MakeMessage", "name": "Make User Msg",
       "pinValues": {"Role": "user"}},
      {"id": 30, "definitionId": "JSON.MakeMessageArray", "name": "Messages"},

      {"id": 40, "definitionId": "LLM.Chat", "name": "Ask LLM"},

      {"id": 80, "definitionId": "PrintString", "name": "Show Reply"},
      {"id": 81, "definitionId": "PrintString", "name": "Show Error",
       "pinValues": {"In String": "ERROR:"}}
    ],
