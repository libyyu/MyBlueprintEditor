      {"id": 15, "definitionId": "GetVariable", "name": "Get ShopItems",
       "nodeData": {"VariableName": "ShopItems"}},
      {"id": 16, "definitionId": "GetVariable", "name": "Get MeetCount",
       "nodeData": {"VariableName": "MeetCount"}},
      {"id": 17, "definitionId": "GetVariable", "name": "Get WorldTime",
       "nodeData": {"VariableName": "WorldTime"}},
      {"id": 18, "definitionId": "GetVariable", "name": "Get InventoryItems",
       "nodeData": {"VariableName": "InventoryItems"}},
