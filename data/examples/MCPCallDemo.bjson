{
  "runtime": {
    "fileType": "runtime",
    "metadata": {
      "schemaVersion": 2,
      "blueprintClass": 0,
      "name": "MCPCallDemo",
      "description": "Demonstrates MCP.Call node with JSON-RPC 2.0 protocol. Calls a local MCP Server tool. Variables: ServerURL, ToolName, Arguments.",
      "version": "1.0"
    },
    "nodes": [
      {
        "id": 1,
        "definitionId": "OnBeginPlay",
        "name": "On Begin Play",
        "pins": [
          { "id": 2, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 10,
        "definitionId": "GetVariable",
        "name": "Get ServerURL",
        "pins": [
          { "id": 11, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "ServerURL" },
          { "id": 12, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },
      {
        "id": 20,
        "definitionId": "GetVariable",
        "name": "Get ToolName",
        "pins": [
          { "id": 21, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "ToolName" },
          { "id": 22, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },
      {
        "id": 30,
        "definitionId": "GetVariable",
        "name": "Get Arguments",
        "pins": [
          { "id": 31, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "Arguments" },
          { "id": 32, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },
      {
        "id": 40,
        "definitionId": "MCP.Call",
        "name": "MCP Tool Call",
        "comment": "JSON-RPC 2.0: POST ServerURL with {jsonrpc,id,method:tools/call,params:{name,arguments}}",
        "pins": [
          { "id": 400, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 401, "kind": 0, "dataType": 4, "name": "ServerURL",  "defaultValue": "http://localhost:7788" },
          { "id": 402, "kind": 0, "dataType": 4, "name": "ToolName",   "defaultValue": "read_file" },
          { "id": 403, "kind": 0, "dataType": 4, "name": "Arguments",  "defaultValue": "{\"path\":\"README.md\"}" },
          { "id": 404, "kind": 0, "dataType": 4, "name": "Protocol",   "defaultValue": "jsonrpc2" },
          { "id": 405, "kind": 0, "dataType": 2, "name": "TimeoutSec", "defaultValue": 30 },
          { "id": 410, "kind": 1, "dataType": 0, "name": "onSuccess",    "isExec": true },
          { "id": 411, "kind": 1, "dataType": 0, "name": "onError",      "isExec": true },
          { "id": 412, "kind": 1, "dataType": 4, "name": "Result" },
          { "id": 413, "kind": 1, "dataType": 4, "name": "RawResult" },
          { "id": 414, "kind": 1, "dataType": 4, "name": "ErrorMessage" }
        ]
      },
      {
        "id": 50,
        "definitionId": "FormatString",
        "name": "Format Result",
        "pins": [
          { "id": 500, "kind": 0, "dataType": 4, "name": "Format",  "defaultValue": "[MCP] Tool={0} Result:\n{1}" },
          { "id": 501, "kind": 0, "dataType": 4, "name": "tool" },
          { "id": 502, "kind": 0, "dataType": 4, "name": "result" },
          { "id": 503, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },
      {
        "id": 60,
        "definitionId": "PrintString",
        "name": "Print Result",
        "pins": [
          { "id": 600, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 601, "kind": 0, "dataType": 4, "name": "In String" },
          { "id": 602, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 70,
        "definitionId": "FormatString",
        "name": "Format Error",
        "pins": [
          { "id": 700, "kind": 0, "dataType": 4, "name": "Format",  "defaultValue": "[MCP] Error calling {0}: {1}" },
          { "id": 701, "kind": 0, "dataType": 4, "name": "tool" },
          { "id": 702, "kind": 0, "dataType": 4, "name": "err" },
          { "id": 703, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },
      {
        "id": 80,
        "definitionId": "PrintString",
        "name": "Print Error",
        "pins": [
          { "id": 800, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 801, "kind": 0, "dataType": 4, "name": "In String" },
          { "id": 802, "kind": 1, "dataType": 0, "isExec": true }
        ]
      }
    ],
    "links": [
      { "id": 1,  "startPinId": 2,   "endPinId": 400, "isEnabled": true },
      { "id": 2,  "startPinId": 12,  "endPinId": 401, "isEnabled": true },
      { "id": 3,  "startPinId": 22,  "endPinId": 402, "isEnabled": true },
      { "id": 4,  "startPinId": 32,  "endPinId": 403, "isEnabled": true },
      { "id": 5,  "startPinId": 410, "endPinId": 600, "isEnabled": true },
      { "id": 6,  "startPinId": 22,  "endPinId": 501, "isEnabled": true },
      { "id": 7,  "startPinId": 412, "endPinId": 502, "isEnabled": true },
      { "id": 8,  "startPinId": 503, "endPinId": 601, "isEnabled": true },
      { "id": 9,  "startPinId": 411, "endPinId": 800, "isEnabled": true },
      { "id": 10, "startPinId": 22,  "endPinId": 701, "isEnabled": true },
      { "id": 11, "startPinId": 414, "endPinId": 702, "isEnabled": true },
      { "id": 12, "startPinId": 703, "endPinId": 801, "isEnabled": true }
    ],
    "variables": [
      { "name": "ServerURL",  "dataType": 4, "defaultValue": "http://localhost:7788" },
      { "name": "ToolName",   "dataType": 4, "defaultValue": "read_file" },
      { "name": "Arguments",  "dataType": 4, "defaultValue": "{\"path\":\"README.md\"}" }
    ]
  },
  "editor": {
    "fileType": "editor",
    "metadata": { "author": "", "createdAt": "", "updatedAt": "" },
