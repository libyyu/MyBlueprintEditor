{
  "runtime": {
    "fileType": "runtime",
    "metadata": {
      "schemaVersion": 2,
      "blueprintClass": 0,
      "name": "ReActAgent",
      "description": "ReAct Agent with real tools: get_weather (wttr.in) and web_search (DuckDuckGo). Uses FireEvent/CustomEventNode to break the exec cycle. Variables: ApiKey, BaseURL, Model, UserQuery.",
      "version": "1.1"
    },
    "nodes": [
      {
        "id": 1,
        "definitionId": "OnBeginPlay",
        "name": "On Begin Play",
        "pins": [
