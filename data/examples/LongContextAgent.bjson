    "metadata": {
      "schemaVersion": 2,
      "blueprintClass": 0,
      "name": "LongContextAgent",
      "description": "Demonstrates Context.Compress: multi-turn chat that auto-compresses history when message count exceeds threshold. Variables: ApiKey, BaseURL, Model, UserQuery, KeepRecent, CompressThreshold.",
      "version": "1.0"
    },
