      "schemaVersion": 2,
      "blueprintClass": 0,
      "name": "PlanExecuteAgent",
      "description": "Plan-Execute Agent: Agent.Plan decomposes Goal into steps, ForLoop iterates each step, Tool.CallByName dispatches to tool functions. Variables: ApiKey, BaseURL, Model, Goal, AvailableTools.",
