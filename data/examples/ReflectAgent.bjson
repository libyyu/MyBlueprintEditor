          { "id": 324, "kind": 1, "dataType": 4, "name": "JSON" },
          { "id": 325, "kind": 1, "dataType": 2, "name": "Length" }
        ]
      },
      {
        "id": 40,
        "definitionId": "LLM.Chat",
        "name": "LLM Generate",
        "pins": [
          { "id": 400, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 401, "kind": 0, "dataType": 4, "name": "BaseURL",      "defaultValue": "https://api.openai.com/v1" },
          { "id": 402, "kind": 0, "dataType": 4, "name": "ApiKey",       "defaultValue": "" },
          { "id": 403, "kind": 0, "dataType": 4, "name": "Model",        "defaultValue": "gpt-4o" },
          { "id": 404, "kind": 0, "dataType": 4, "name": "Messages" },
          { "id": 405, "kind": 0, "dataType": 4, "name": "SystemPrompt", "defaultValue": "You are a helpful writer. Write clear, concise content." },
          { "id": 406, "kind": 0, "dataType": 2, "name": "MaxTokens",    "defaultValue": 512 },
          { "id": 407, "kind": 0, "dataType": 3, "name": "Temperature",  "defaultValue": 0.7 },
          { "id": 408, "kind": 0, "dataType": 4, "name": "Tools",        "defaultValue": "" },
          { "id": 409, "kind": 1, "dataType": 0, "name": "onReply",    "isExec": true },
          { "id": 410, "kind": 1, "dataType": 0, "name": "onToolCall", "isExec": true },
          { "id": 411, "kind": 1, "dataType": 0, "name": "onError",    "isExec": true },
          { "id": 412, "kind": 1, "dataType": 4, "name": "Reply" },
          { "id": 413, "kind": 1, "dataType": 4, "name": "ToolCallsJSON" },
          { "id": 414, "kind": 1, "dataType": 4, "name": "FinishReason" },
          { "id": 415, "kind": 1, "dataType": 4, "name": "FullResponse" },
          { "id": 416, "kind": 1, "dataType": 4, "name": "ErrorMessage" }
        ]
      },
      {
        "id": 50,
        "definitionId": "Agent.Reflect",
        "name": "Reflect",
        "pins": [
          { "id": 500, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 501, "kind": 0, "dataType": 4, "name": "BaseURL" },
          { "id": 502, "kind": 0, "dataType": 4, "name": "ApiKey" },
          { "id": 503, "kind": 0, "dataType": 4, "name": "Model" },
          { "id": 504, "kind": 0, "dataType": 4, "name": "Output" },
          { "id": 505, "kind": 0, "dataType": 4, "name": "Criteria" },
          { "id": 506, "kind": 0, "dataType": 2, "name": "MaxTokens", "defaultValue": 256 },
          { "id": 507, "kind": 1, "dataType": 0, "name": "onPass",  "isExec": true },
          { "id": 508, "kind": 1, "dataType": 0, "name": "onFail",  "isExec": true },
          { "id": 509, "kind": 1, "dataType": 0, "name": "onError", "isExec": true },
          { "id": 510, "kind": 1, "dataType": 4, "name": "Feedback" },
          { "id": 511, "kind": 1, "dataType": 4, "name": "Score" },
          { "id": 512, "kind": 1, "dataType": 4, "name": "ErrorMessage" }
        ]
      },
      {
        "id": 60,
        "definitionId": "PrintString",
        "name": "Print Pass",
        "pins": [
          { "id": 600, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 601, "kind": 0, "dataType": 4, "name": "In String" },
          { "id": 602, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 61,
        "definitionId": "GetVariable",
        "name": "Get retryCount",
        "pins": [
          { "id": 610, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "retryCount" },
          { "id": 611, "kind": 1, "dataType": 2, "name": "Value" }
        ]
      },
      {
        "id": 62,
        "definitionId": "GetVariable",
        "name": "Get MaxRetries",
        "pins": [
          { "id": 620, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "MaxRetries" },
          { "id": 621, "kind": 1, "dataType": 2, "name": "Value" }
        ]
      },
      {
        "id": 63,
        "definitionId": "Less",
        "name": "retryCount < MaxRetries",
        "pins": [
          { "id": 630, "kind": 0, "dataType": 2, "name": "A" },
          { "id": 631, "kind": 0, "dataType": 2, "name": "B" },
          { "id": 632, "kind": 1, "dataType": 1, "name": "Result" }
        ]
      },
      {
        "id": 64,
        "definitionId": "Branch",
        "name": "Can Retry?",
        "pins": [
          { "id": 640, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 641, "kind": 0, "dataType": 1, "name": "Condition" },
          { "id": 642, "kind": 1, "dataType": 0, "name": "True",  "isExec": true },
          { "id": 643, "kind": 1, "dataType": 0, "name": "False", "isExec": true }
        ]
      },
      {
        "id": 65,
        "definitionId": "Add",
        "name": "retryCount + 1",
        "pins": [
          { "id": 650, "kind": 0, "dataType": 2, "name": "A" },
          { "id": 651, "kind": 0, "dataType": 2, "name": "B", "defaultValue": 1 },
          { "id": 652, "kind": 1, "dataType": 2, "name": "Result" }
        ]
      },
      {
        "id": 66,
        "definitionId": "SetVariable",
        "name": "Save retryCount",
        "pins": [
          { "id": 660, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 661, "kind": 0, "dataType": 4, "name": "Name",  "defaultValue": "retryCount" },
          { "id": 662, "kind": 0, "dataType": 2, "name": "Value" },
