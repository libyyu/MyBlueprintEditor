        "pins": [
          { "id": 230, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "Topic" },
          { "id": 231, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },
      {
        "id": 24,
        "definitionId": "GetVariable",
        "name": "Get Criteria",
        "pins": [
          { "id": 240, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "Criteria" },
          { "id": 241, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },
      {
        "id": 25,
        "definitionId": "GetVariable",
        "name": "Get feedback",
        "pins": [
          { "id": 250, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "feedback" },
          { "id": 251, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },
      {
        "id": 30,
        "definitionId": "FormatString",
        "name": "Build Prompt",
        "pins": [
          { "id": 300, "kind": 0, "dataType": 4, "name": "Format",
            "defaultValue": "Write a short paragraph about: {0}. Previous feedback to address: {1}" },
          { "id": 301, "kind": 0, "dataType": 4, "name": "topic" },
          { "id": 302, "kind": 0, "dataType": 4, "name": "prev_feedback" },
          { "id": 303, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },
      {
        "id": 31,
        "definitionId": "JSON.MakeMessage",
        "name": "Make User Msg",
        "pins": [
          { "id": 310, "kind": 0, "dataType": 4, "name": "Role",       "defaultValue": "user" },
          { "id": 311, "kind": 0, "dataType": 4, "name": "Content" },
          { "id": 312, "kind": 0, "dataType": 4, "name": "ToolCallId", "defaultValue": "" },
          { "id": 313, "kind": 1, "dataType": 4, "name": "Message" }
        ]
      },
      {
        "id": 32,
        "definitionId": "JSON.ArrayPush",
