{
  "runtime": {
    "fileType": "runtime",
    "metadata": {
      "schemaVersion": 2,
      "blueprintClass": 0,
      "name": "ReflectAgent",
      "description": "Demonstrates Agent.Reflect: LLM generates content, Reflect evaluates it, onFail triggers retry with feedback. Variables: ApiKey, BaseURL, Model, Topic, Criteria, MaxRetries.",
      "version": "1.0"
    },
    "nodes": [
      {
        "id": 1,
        "definitionId": "OnBeginPlay",
        "name": "On Begin Play",
        "pins": [
          { "id": 2, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 10,
        "definitionId": "SetVariable",
        "name": "Init retry count",
        "pins": [
          { "id": 100, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 101, "kind": 0, "dataType": 4, "name": "Name",  "defaultValue": "retryCount" },
          { "id": 102, "kind": 0, "dataType": 2, "name": "Value", "defaultValue": 0 },
          { "id": 103, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 11,
        "definitionId": "SetVariable",
        "name": "Init feedback",
        "pins": [
          { "id": 110, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 111, "kind": 0, "dataType": 4, "name": "Name",  "defaultValue": "feedback" },
