      },
      {
        "id": 69,
        "definitionId": "CustomEventNode",
        "name": "DoGenerate",
        "nodeData": { "EventName": "DoGenerate" },
        "pins": [
          { "id": 690, "kind": 1, "dataType": 0, "isExec": true },
          { "id": 691, "kind": 1, "dataType": 4, "name": "EventName" }
        ]
      },
