        ]
      },
      {
        "id": 67,
        "definitionId": "SetVariable",
        "name": "Save feedback",
        "pins": [
          { "id": 670, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 671, "kind": 0, "dataType": 4, "name": "Name",  "defaultValue": "feedback" },
