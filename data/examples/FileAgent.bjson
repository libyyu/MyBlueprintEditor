        ]
      },
      {
        "id": 35,
        "definitionId": "String.Template",
        "name": "Build LLM Prompt",
        "comment": "Combine user prompt + file content",
        "pins": [
          { "id": 350, "kind": 0, "dataType": 4, "name": "Template",
            "defaultValue": "{{prompt}}\n\n---\nFile content:\n{{content}}" },
          { "id": 351, "kind": 0, "dataType": 6, "name": "Keys",   "defaultValue": ["prompt", "content"] },
          { "id": 352, "kind": 0, "dataType": 6, "name": "Values", "defaultValue": ["", ""] },
          { "id": 353, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },
      {
        "id": 40,
