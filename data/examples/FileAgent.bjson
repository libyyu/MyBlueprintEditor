{
  "runtime": {
    "fileType": "runtime",
    "metadata": {
      "schemaVersion": 2,
      "blueprintClass": 0,
      "name": "FileAgent",
      "description": "File Agent: read a source file, ask LLM to analyze/transform it, write result to output file. Variables: ApiKey, BaseURL, Model, InputFile, OutputFile, Prompt.",
      "version": "1.0"
    },
    "nodes": [
      {
        "id": 1,
        "definitionId": "OnBeginPlay",
        "name": "On Begin Play",
        "pins": [
          { "id": 2, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 10,
        "definitionId": "GetVariable",
        "name": "Get InputFile",
        "pins": [
          { "id": 11, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "InputFile" },
          { "id": 12, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },
      {
        "id": 20,
        "definitionId": "File.ReadText",
        "name": "Read Source File",
