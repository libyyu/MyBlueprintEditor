          { "id": 14022, "kind": 1, "dataType": 2, "name": "ExitCode" }
        ]
      },

      { "id": 15, "definitionId": "String.Regex", "name": "Extract CL List",
        "pins": [
          { "id": 15001, "kind": 0, "dataType": 4, "name": "String" },
          { "id": 15002, "kind": 0, "dataType": 4, "name": "Pattern", "defaultValue": "Change (\\d+) on" },
          { "id": 15003, "kind": 0, "dataType": 4, "name": "Replacement", "defaultValue": "" },
          { "id": 15004, "kind": 0, "dataType": 4, "name": "Mode", "defaultValue": "findall" },
          { "id": 15010, "kind": 1, "dataType": 1, "name": "Found" },
          { "id": 15011, "kind": 1, "dataType": 4, "name": "Match0" },
          { "id": 15012, "kind": 1, "dataType": 4, "name": "Match1" },
          { "id": 15013, "kind": 1, "dataType": 4, "name": "Match2" },
          { "id": 15014, "kind": 1, "dataType": 4, "name": "Match3" },
          { "id": 15015, "kind": 1, "dataType": 6, "name": "Matches" },
          { "id": 15016, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },

      { "id": 16, "definitionId": "SetVariable", "name": "Set CLList",
        "pins": [
          { "id": 16001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 16002, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "CLList" },
          { "id": 16003, "kind": 0, "dataType": 9, "name": "Value" },
          { "id": 16010, "kind": 1, "dataType": 0, "isExec": true }
        ]
