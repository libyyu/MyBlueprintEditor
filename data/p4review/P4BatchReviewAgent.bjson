      { "id": 17, "definitionId": "GetVariable", "name": "Get CLList",
        "pins": [
          { "id": 17001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "CLList" },
          { "id": 17010, "kind": 1, "dataType": 6, "name": "Value" }
        ]
      },

      { "id": 18, "definitionId": "FormatString", "name": "Build Confirm Msg",
        "pins": [
          { "id": 18001, "kind": 0, "dataType": 4, "name": "Format",
            "defaultValue": "📋 找到以下CL待审查（共{0}个）：\n{1}\n\n⏳ 开始批量审查..." },
