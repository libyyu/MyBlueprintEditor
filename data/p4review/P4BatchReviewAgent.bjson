{
  "runtime": {
    "metadata": { "blueprintClass": 0, "name": "P4BatchReviewAgent", "schemaVersion": 2 },
    "_comment": "批量审查指定用户在某分支上 startCL 之后的所有提交。变量注入：UserQuery(如 'batch review //depot/branch/ username 12345'), P4Client, ApiKey, BaseURL, Model, OutputDir, WorkDir",

    "nodes": [
      { "id": 1, "definitionId": "OnBeginPlay", "name": "On Begin Play",
        "pins": [{ "id": 1001, "kind": 1, "dataType": 0, "isExec": true }] },

      { "id": 2, "definitionId": "GetVariable", "name": "Get UserQuery",
        "pins": [
          { "id": 2001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "UserQuery" },
          { "id": 2010, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },

      { "id": 3, "definitionId": "String.Regex", "name": "Parse Batch Args",
        "pins": [
          { "id": 3001, "kind": 0, "dataType": 4, "name": "String" },
          { "id": 3002, "kind": 0, "dataType": 4, "name": "Pattern",
            "defaultValue": "batch\\s+review\\s+(\\S+)\\s+(\\S+)\\s+(\\d+)" },
          { "id": 3003, "kind": 0, "dataType": 4, "name": "Replacement", "defaultValue": "" },
          { "id": 3004, "kind": 0, "dataType": 4, "name": "Mode", "defaultValue": "match" },
          { "id": 3010, "kind": 1, "dataType": 1, "name": "Found" },
          { "id": 3011, "kind": 1, "dataType": 4, "name": "Match0" },
          { "id": 3012, "kind": 1, "dataType": 4, "name": "Match1" },
          { "id": 3013, "kind": 1, "dataType": 4, "name": "Match2" },
          { "id": 3014, "kind": 1, "dataType": 4, "name": "Match3" },
          { "id": 3015, "kind": 1, "dataType": 6, "name": "Matches" },
          { "id": 3016, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },

      { "id": 4, "definitionId": "Branch", "name": "Branch: Parsed?",
        "pins": [
          { "id": 4001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 4002, "kind": 0, "dataType": 1, "name": "Condition" },
          { "id": 4010, "kind": 1, "dataType": 0, "isExec": true, "name": "True" },
          { "id": 4011, "kind": 1, "dataType": 0, "isExec": true, "name": "False" }
        ]
      },

      { "id": 5, "definitionId": "PrintString", "name": "Print Parse Error",
        "pins": [
          { "id": 5001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 5002, "kind": 0, "dataType": 4, "name": "In String",
            "defaultValue": "❌ 格式错误，请使用：batch review //depot/branch/ username 12345" },
          { "id": 5010, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },

      { "id": 6, "definitionId": "SetVariable", "name": "Set BranchPath",
        "pins": [
          { "id": 6001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 6002, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "BranchPath" },
          { "id": 6003, "kind": 0, "dataType": 9, "name": "Value" },
          { "id": 6010, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },

      { "id": 7, "definitionId": "SetVariable", "name": "Set P4User",
        "pins": [
          { "id": 7001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 7002, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "P4User" },
          { "id": 7003, "kind": 0, "dataType": 9, "name": "Value" },
          { "id": 7010, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },

      { "id": 8, "definitionId": "SetVariable", "name": "Set StartCL",
        "pins": [
          { "id": 8001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 8002, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "StartCL" },
          { "id": 8003, "kind": 0, "dataType": 9, "name": "Value" },
          { "id": 8010, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },

      { "id": 9, "definitionId": "GetVariable", "name": "Get P4Client",
        "pins": [
          { "id": 9001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "P4Client" },
          { "id": 9010, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },

      { "id": 10, "definitionId": "GetVariable", "name": "Get BranchPath",
        "pins": [
          { "id": 10001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "BranchPath" },
          { "id": 10010, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },

      { "id": 11, "definitionId": "GetVariable", "name": "Get P4User",
        "pins": [
          { "id": 11001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "P4User" },
          { "id": 11010, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },

      { "id": 12, "definitionId": "GetVariable", "name": "Get StartCL",
        "pins": [
          { "id": 12001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "StartCL" },
          { "id": 12010, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },

      { "id": 13, "definitionId": "FormatString", "name": "Build p4 changes cmd",
        "pins": [
          { "id": 13001, "kind": 0, "dataType": 4, "name": "Format",
            "defaultValue": "cmd /c \"chcp 65001 >nul && p4 -c {0} changes -u {1} -s submitted -l {2}/...@{3},@now\"" },
          { "id": 13002, "kind": 0, "dataType": 9, "name": "Arg 0" },
          { "id": 13003, "kind": 0, "dataType": 9, "name": "Arg 1" },
          { "id": 13004, "kind": 0, "dataType": 9, "name": "Arg 2" },
          { "id": 13005, "kind": 0, "dataType": 9, "name": "Arg 3" },
          { "id": 13010, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },

      { "id": 14, "definitionId": "Code.Run", "name": "p4 changes",
        "pins": [
          { "id": 14001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 14002, "kind": 0, "dataType": 4, "name": "Command" },
          { "id": 14003, "kind": 0, "dataType": 4, "name": "WorkDir" },
          { "id": 14004, "kind": 0, "dataType": 2, "name": "TimeoutSeconds", "defaultValue": 60 },
