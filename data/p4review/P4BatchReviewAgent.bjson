          { "id": 35001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 35002, "kind": 0, "dataType": 4, "name": "BaseURL" },
          { "id": 35003, "kind": 0, "dataType": 4, "name": "ApiKey" },
          { "id": 35004, "kind": 0, "dataType": 4, "name": "Model" },
          { "id": 35005, "kind": 0, "dataType": 4, "name": "Messages" },
          { "id": 35006, "kind": 0, "dataType": 4, "name": "SystemPrompt",
            "defaultValue": "你是资深代码审查专家，请用中文输出详细的Markdown格式审查报告，包含：问题清单（Critical/Warning/Info）、评分（X/10）和审查结论（✅通过/⚠️有条件通过/❌不通过）。" },
          { "id": 35007, "kind": 0, "dataType": 2, "name": "MaxTokens", "defaultValue": 4096 },
          { "id": 35010, "kind": 1, "dataType": 0, "isExec": true, "name": "onReply" },
