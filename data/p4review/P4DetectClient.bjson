      },
      {
        "id": 3, "definitionId": "FormatString", "name": "Build p4 clients cmd",
        "pins": [
          { "id": 3001, "kind": 0, "dataType": 4, "name": "Format",
            "defaultValue": "cmd /c \"chcp 65001 >nul && p4 clients -u {0}\"" },
          { "id": 3002, "kind": 0, "dataType": 9, "name": "Arg 0" },
          { "id": 3010, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },
      {
