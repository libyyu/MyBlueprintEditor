{
  "runtime": {
    "metadata": { "blueprintClass": 0, "name": "P4DetectClient", "schemaVersion": 2 },
    "nodes": [
      {
        "id": 1, "definitionId": "OnBeginPlay", "name": "On Begin Play",
        "pins": [{ "id": 1001, "kind": 1, "dataType": 0, "isExec": true }]
      },
      {
        "id": 2, "definitionId": "GetVariable", "name": "Get P4User",
