{
  "runtime": {
    "metadata": {
      "blueprintClass": 0,
      "name": "FeishuBot",
      "description": "Feishu bot via HTTP event callback. Receives Feishu events, replies via REST API.\nVariables to set: AppId, AppSecret, (optional) VerificationToken.",
      "schemaVersion": 2
    },
    "variables": [
      { "name": "AppId",             "type": 4, "defaultValue": "cli_xxxxxxxxxxxxxxxx" },
      { "name": "AppSecret",         "type": 4, "defaultValue": "your_app_secret_here" },
      { "name": "VerificationToken", "type": 4, "defaultValue": "" },
      { "name": "Model",             "type": 4, "defaultValue": "gpt-4o-mini" },
      { "name": "BaseURL",           "type": 4, "defaultValue": "https://api.openai.com/v1" },
      { "name": "ApiKey",            "type": 4, "defaultValue": "sk-xxxxxxxx" },
      { "name": "SystemPrompt",      "type": 4, "defaultValue": "You are a helpful assistant." },
      { "name": "_AccessToken",      "type": 4, "defaultValue": "" },
      { "name": "_TokenExpiry",      "type": 2, "defaultValue": 0 }
    ],
    "nodes": [

      {
        "id": 1, "definitionId": "OnBeginPlay", "name": "On Begin Play",
        "pins": [{ "id": 1001, "kind": 1, "dataType": 0, "isExec": true }]
      },

      {
        "id": 2, "definitionId": "PrintString", "name": "Print Ready",
        "pins": [
          { "id": 2001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 2002, "kind": 0, "dataType": 4, "name": "In String",
            "defaultValue": "[FeishuBot] Listening on port 7801. Configure your Feishu app event URL to http://YOUR_HOST:7801" },
          { "id": 2010, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },

      {
        "id": 3, "definitionId": "HTTP.Listen", "name": "Feishu Event Server",
        "pins": [
          { "id": 3001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 3002, "kind": 0, "dataType": 2, "name": "Port",       "defaultValue": 7801 },
          { "id": 3003, "kind": 0, "dataType": 4, "name": "Path",       "defaultValue": "/" },
          { "id": 3004, "kind": 0, "dataType": 4, "name": "AllowedMethods", "defaultValue": "POST" },
          { "id": 3010, "kind": 1, "dataType": 0, "isExec": true, "name": "onRequest" },
          { "id": 3020, "kind": 1, "dataType": 4, "name": "Method" },
          { "id": 3021, "kind": 1, "dataType": 4, "name": "Path" },
          { "id": 3022, "kind": 1, "dataType": 4, "name": "Body" },
          { "id": 3023, "kind": 1, "dataType": 4, "name": "Headers" },
          { "id": 3024, "kind": 1, "dataType": 2, "name": "RequestId" }
        ]
      },

      {
        "id": 4, "definitionId": "JSON.GetPath", "name": "Parse Challenge",
        "nodeData": { "comment": "Feishu URL verification: challenge field" },
        "pins": [
          { "id": 4001, "kind": 0, "dataType": 4, "name": "JSON" },
          { "id": 4002, "kind": 0, "dataType": 4, "name": "Path", "defaultValue": "challenge" },
          { "id": 4010, "kind": 1, "dataType": 9, "name": "Value" },
          { "id": 4011, "kind": 1, "dataType": 1, "name": "Found" }
        ]
      },

      {
        "id": 5, "definitionId": "Branch", "name": "Is URL Verify?",
        "pins": [
          { "id": 5001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 5002, "kind": 0, "dataType": 1, "name": "Condition" },
          { "id": 5010, "kind": 1, "dataType": 0, "isExec": true, "name": "True" },
          { "id": 5011, "kind": 1, "dataType": 0, "isExec": true, "name": "False" }
        ]
      },

      {
        "id": 6, "definitionId": "FormatString", "name": "Build Challenge Response",
        "pins": [
          { "id": 6001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 6002, "kind": 0, "dataType": 4, "name": "Format", "defaultValue": "{\"challenge\":\"{0}\"}" },
          { "id": 6003, "kind": 0, "dataType": 9, "name": "Arg0" },
          { "id": 6010, "kind": 1, "dataType": 0, "isExec": true },
          { "id": 6020, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },

      {
        "id": 7, "definitionId": "HTTP.Respond", "name": "Respond Challenge",
        "pins": [
          { "id": 7001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 7002, "kind": 0, "dataType": 2, "name": "RequestId" },
          { "id": 7003, "kind": 0, "dataType": 2, "name": "StatusCode", "defaultValue": 200 },
          { "id": 7004, "kind": 0, "dataType": 4, "name": "Body" },
          { "id": 7005, "kind": 0, "dataType": 4, "name": "ContentType", "defaultValue": "application/json" },
          { "id": 7010, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },

      {
        "id": 8, "definitionId": "HTTP.Respond", "name": "Ack 200 First",
        "nodeData": { "comment": "Immediately return 200 to Feishu to prevent retry" },
        "pins": [
          { "id": 8001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 8002, "kind": 0, "dataType": 2, "name": "RequestId" },
          { "id": 8003, "kind": 0, "dataType": 2, "name": "StatusCode", "defaultValue": 200 },
          { "id": 8004, "kind": 0, "dataType": 4, "name": "Body",        "defaultValue": "{\"code\":0}" },
          { "id": 8005, "kind": 0, "dataType": 4, "name": "ContentType", "defaultValue": "application/json" },
          { "id": 8010, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },

      {
        "id": 9, "definitionId": "JSON.GetPath", "name": "Get Event Type",
        "pins": [
          { "id": 9001, "kind": 0, "dataType": 4, "name": "JSON" },
          { "id": 9002, "kind": 0, "dataType": 4, "name": "Path", "defaultValue": "header.event_type" },
          { "id": 9010, "kind": 1, "dataType": 9, "name": "Value" },
          { "id": 9011, "kind": 1, "dataType": 1, "name": "Found" }
        ]
      },

      {
        "id": 10, "definitionId": "Branch", "name": "Is Message Event?",
        "pins": [
          { "id": 10001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 10002, "kind": 0, "dataType": 1, "name": "Condition" },
          { "id": 10010, "kind": 1, "dataType": 0, "isExec": true, "name": "True" },
          { "id": 10011, "kind": 1, "dataType": 0, "isExec": true, "name": "False" }
        ]
      },

      {
        "id": 11, "definitionId": "AppendString", "name": "Check Event Type",
        "nodeData": { "comment": "event_type == im.message.receive_v1" },
        "pins": [
          { "id": 11001, "kind": 0, "dataType": 4, "name": "A" },
          { "id": 11002, "kind": 0, "dataType": 4, "name": "B", "defaultValue": "im.message.receive_v1" },
          { "id": 11010, "kind": 1, "dataType": 1, "name": "Result" }
        ]
      },

      {
        "id": 12, "definitionId": "Equal", "name": "Event Type Equal",
        "pins": [
          { "id": 12001, "kind": 0, "dataType": 9, "name": "A" },
          { "id": 12002, "kind": 0, "dataType": 4, "name": "B", "defaultValue": "im.message.receive_v1" },
          { "id": 12010, "kind": 1, "dataType": 1, "name": "Result" }
        ]
      },

      {
        "id": 13, "definitionId": "JSON.GetPath", "name": "Get Message ID",
        "pins": [
          { "id": 13001, "kind": 0, "dataType": 4, "name": "JSON" },
          { "id": 13002, "kind": 0, "dataType": 4, "name": "Path", "defaultValue": "event.message.message_id" },
          { "id": 13010, "kind": 1, "dataType": 9, "name": "Value" },
          { "id": 13011, "kind": 1, "dataType": 1, "name": "Found" }
        ]
      },

      {
        "id": 14, "definitionId": "JSON.GetPath", "name": "Get Content JSON",
        "nodeData": { "comment": "event.message.content is a JSON string like {\"text\":\"hello\"}" },
        "pins": [
          { "id": 14001, "kind": 0, "dataType": 4, "name": "JSON" },
          { "id": 14002, "kind": 0, "dataType": 4, "name": "Path", "defaultValue": "event.message.content" },
          { "id": 14010, "kind": 1, "dataType": 9, "name": "Value" },
          { "id": 14011, "kind": 1, "dataType": 1, "name": "Found" }
        ]
      },

      {
        "id": 15, "definitionId": "JSON.GetPath", "name": "Get Text",
        "nodeData": { "comment": "Parse inner JSON: {\"text\":\"...\"}" },
        "pins": [
          { "id": 15001, "kind": 0, "dataType": 4, "name": "JSON" },
          { "id": 15002, "kind": 0, "dataType": 4, "name": "Path", "defaultValue": "text" },
          { "id": 15010, "kind": 1, "dataType": 9, "name": "Value" },
          { "id": 15011, "kind": 1, "dataType": 1, "name": "Found" }
        ]
      },

      {
        "id": 16, "definitionId": "GetVariable", "name": "Get AppId",
        "pins": [
          { "id": 16001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "AppId" },
          { "id": 16010, "kind": 1, "dataType": 9, "name": "Value" }
        ]
      },

      {
        "id": 17, "definitionId": "GetVariable", "name": "Get AppSecret",
        "pins": [
          { "id": 17001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "AppSecret" },
          { "id": 17010, "kind": 1, "dataType": 9, "name": "Value" }
        ]
      },

      {
        "id": 18, "definitionId": "JSON.BuildObject", "name": "Build Token Request",
        "pins": [
          { "id": 18001, "kind": 0, "dataType": 4, "name": "Keys",   "defaultValue": "app_id,app_secret" },
          { "id": 18002, "kind": 0, "dataType": 9, "name": "Value0" },
          { "id": 18003, "kind": 0, "dataType": 9, "name": "Value1" },
          { "id": 18010, "kind": 1, "dataType": 4, "name": "JSON" }
        ]
      },

      {
        "id": 19, "definitionId": "HTTP.Post", "name": "Get Access Token",
        "nodeData": { "comment": "POST https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal" },
        "pins": [
          { "id": 19001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 19002, "kind": 0, "dataType": 4, "name": "URL",
            "defaultValue": "https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal" },
          { "id": 19003, "kind": 0, "dataType": 4, "name": "Body" },
          { "id": 19004, "kind": 0, "dataType": 4, "name": "ContentType", "defaultValue": "application/json" },
          { "id": 19010, "kind": 1, "dataType": 0, "isExec": true, "name": "onSuccess" },
          { "id": 19011, "kind": 1, "dataType": 0, "isExec": true, "name": "onError" },
          { "id": 19020, "kind": 1, "dataType": 4, "name": "Response" },
          { "id": 19021, "kind": 1, "dataType": 2, "name": "StatusCode" }
        ]
      },

      {
        "id": 20, "definitionId": "JSON.GetPath", "name": "Get Token Value",
        "pins": [
          { "id": 20001, "kind": 0, "dataType": 4, "name": "JSON" },
          { "id": 20002, "kind": 0, "dataType": 4, "name": "Path", "defaultValue": "tenant_access_token" },
          { "id": 20010, "kind": 1, "dataType": 9, "name": "Value" },
          { "id": 20011, "kind": 1, "dataType": 1, "name": "Found" }
        ]
      },

      {
        "id": 21, "definitionId": "SetVariable", "name": "Save Token",
        "pins": [
          { "id": 21001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 21002, "kind": 0, "dataType": 4, "name": "Name",  "defaultValue": "_AccessToken" },
          { "id": 21003, "kind": 0, "dataType": 9, "name": "Value" },
          { "id": 21010, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },

      {
        "id": 22, "definitionId": "GetVariable", "name": "Get System Prompt",
        "pins": [
          { "id": 22001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "SystemPrompt" },
          { "id": 22010, "kind": 1, "dataType": 9, "name": "Value" }
        ]
      },

      {
        "id": 23, "definitionId": "GetVariable", "name": "Get Model",
        "pins": [
          { "id": 23001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "Model" },
          { "id": 23010, "kind": 1, "dataType": 9, "name": "Value" }
        ]
      },

      {
        "id": 24, "definitionId": "GetVariable", "name": "Get BaseURL",
        "pins": [
          { "id": 24001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "BaseURL" },
          { "id": 24010, "kind": 1, "dataType": 9, "name": "Value" }
        ]
      },

      {
        "id": 25, "definitionId": "GetVariable", "name": "Get ApiKey",
        "pins": [
          { "id": 25001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "ApiKey" },
          { "id": 25010, "kind": 1, "dataType": 9, "name": "Value" }
        ]
      },

      {
        "id": 26, "definitionId": "LLM.Chat", "name": "LLM Reply",
        "pins": [
          { "id": 26001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 26002, "kind": 0, "dataType": 4, "name": "UserMessage" },
          { "id": 26003, "kind": 0, "dataType": 4, "name": "SystemPrompt" },
          { "id": 26004, "kind": 0, "dataType": 4, "name": "Model" },
          { "id": 26005, "kind": 0, "dataType": 4, "name": "BaseURL" },
          { "id": 26006, "kind": 0, "dataType": 4, "name": "ApiKey" },
          { "id": 26010, "kind": 1, "dataType": 0, "isExec": true, "name": "onReply" },
          { "id": 26011, "kind": 1, "dataType": 0, "isExec": true, "name": "onError" },
          { "id": 26020, "kind": 1, "dataType": 4, "name": "Reply" },
          { "id": 26021, "kind": 1, "dataType": 4, "name": "ErrorMessage" }
        ]
      },

      {
        "id": 27, "definitionId": "GetVariable", "name": "Get Token for Reply",
        "pins": [
          { "id": 27001, "kind": 0, "dataType": 4, "name": "Name", "defaultValue": "_AccessToken" },
          { "id": 27010, "kind": 1, "dataType": 9, "name": "Value" }
        ]
      },

      {
        "id": 28, "definitionId": "FormatString", "name": "Build Auth Header",
        "pins": [
          { "id": 28001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 28002, "kind": 0, "dataType": 4, "name": "Format", "defaultValue": "Bearer {0}" },
          { "id": 28003, "kind": 0, "dataType": 9, "name": "Arg0" },
          { "id": 28010, "kind": 1, "dataType": 0, "isExec": true },
          { "id": 28020, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },

      {
        "id": 29, "definitionId": "JSON.BuildObject", "name": "Build Reply Body",
        "nodeData": { "comment": "POST body: {\"content\":\"{\\\"text\\\":\\\"...\\\"}\"}" },
        "pins": [
          { "id": 29001, "kind": 0, "dataType": 4, "name": "Keys",   "defaultValue": "content,msg_type" },
          { "id": 29002, "kind": 0, "dataType": 9, "name": "Value0" },
          { "id": 29003, "kind": 0, "dataType": 4, "name": "Value1", "defaultValue": "text" },
          { "id": 29010, "kind": 1, "dataType": 4, "name": "JSON" }
        ]
      },

      {
        "id": 30, "definitionId": "FormatString", "name": "Wrap Text Content",
        "pins": [
          { "id": 30001, "kind": 0, "dataType": 4, "name": "Format", "defaultValue": "{\"text\":\"{0}\"}" },
          { "id": 30002, "kind": 0, "dataType": 9, "name": "Arg0" },
          { "id": 30010, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },

      {
        "id": 31, "definitionId": "FormatString", "name": "Build Reply URL",
        "pins": [
          { "id": 31001, "kind": 0, "dataType": 4, "name": "Format",
            "defaultValue": "https://open.feishu.cn/open-apis/im/v1/messages/{0}/reply" },
          { "id": 31002, "kind": 0, "dataType": 9, "name": "Arg0" },
          { "id": 31010, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },

      {
        "id": 32, "definitionId": "JSON.BuildObject", "name": "Build Request Headers",
        "pins": [
          { "id": 32001, "kind": 0, "dataType": 4, "name": "Keys",   "defaultValue": "Authorization" },
          { "id": 32002, "kind": 0, "dataType": 9, "name": "Value0" },
          { "id": 32010, "kind": 1, "dataType": 4, "name": "JSON" }
        ]
      },

      {
        "id": 33, "definitionId": "HTTP.Request", "name": "Send Reply to Feishu",
        "pins": [
          { "id": 33001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 33002, "kind": 0, "dataType": 4, "name": "URL" },
          { "id": 33003, "kind": 0, "dataType": 4, "name": "Method",      "defaultValue": "POST" },
          { "id": 33004, "kind": 0, "dataType": 4, "name": "Body" },
          { "id": 33005, "kind": 0, "dataType": 4, "name": "Headers" },
          { "id": 33006, "kind": 0, "dataType": 4, "name": "ContentType", "defaultValue": "application/json" },
          { "id": 33010, "kind": 1, "dataType": 0, "isExec": true, "name": "onSuccess" },
          { "id": 33011, "kind": 1, "dataType": 0, "isExec": true, "name": "onError" },
          { "id": 33020, "kind": 1, "dataType": 4, "name": "Response" },
          { "id": 33021, "kind": 1, "dataType": 2, "name": "StatusCode" }
        ]
      },

      {
        "id": 34, "definitionId": "PrintString", "name": "Print Success",
        "pins": [
          { "id": 34001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 34002, "kind": 0, "dataType": 4, "name": "In String", "defaultValue": "[FeishuBot] Reply sent successfully" },
          { "id": 34010, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },

      {
        "id": 35, "definitionId": "PrintString", "name": "Print LLM Error",
        "pins": [
          { "id": 35001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 35002, "kind": 0, "dataType": 4, "name": "In String" },
          { "id": 35010, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },

      {
        "id": 36, "definitionId": "FormatString", "name": "Build LLM Error Msg",
        "pins": [
          { "id": 36001, "kind": 0, "dataType": 4, "name": "Format", "defaultValue": "[FeishuBot] LLM error: {0}" },
          { "id": 36002, "kind": 0, "dataType": 9, "name": "Arg0" },
          { "id": 36010, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      }

    ],
    "links": [
      { "id": 101, "startPinId": 1001,  "endPinId": 2001  },
      { "id": 102, "startPinId": 2010,  "endPinId": 3001  },

      { "id": 103, "startPinId": 3010,  "endPinId": 5001  },
      { "id": 104, "startPinId": 3022,  "endPinId": 4001  },
      { "id": 105, "startPinId": 4011,  "endPinId": 5002  },
      { "id": 106, "startPinId": 4010,  "endPinId": 6003  },

      { "id": 107, "startPinId": 5010,  "endPinId": 6001  },
      { "id": 108, "startPinId": 6020,  "endPinId": 7004  },
      { "id": 109, "startPinId": 3024,  "endPinId": 7002  },
      { "id": 110, "startPinId": 6010,  "endPinId": 7001  },

      { "id": 111, "startPinId": 5011,  "endPinId": 8001  },
      { "id": 112, "startPinId": 3024,  "endPinId": 8002  },

      { "id": 113, "startPinId": 8010,  "endPinId": 19001 },

      { "id": 114, "startPinId": 3022,  "endPinId": 9001  },
      { "id": 115, "startPinId": 9010,  "endPinId": 12001 },
      { "id": 116, "startPinId": 12010, "endPinId": 10002 },
      { "id": 117, "startPinId": 10010, "endPinId": 26001 },
      { "id": 118, "startPinId": 10011, "endPinId": 34001 },

      { "id": 119, "startPinId": 3022,  "endPinId": 13001 },
      { "id": 120, "startPinId": 13010, "endPinId": 28003 },

      { "id": 121, "startPinId": 3022,  "endPinId": 14001 },
      { "id": 122, "startPinId": 14010, "endPinId": 15001 },
      { "id": 123, "startPinId": 15010, "endPinId": 26002 },

      { "id": 124, "startPinId": 16010, "endPinId": 18002 },
      { "id": 125, "startPinId": 17010, "endPinId": 18003 },
      { "id": 126, "startPinId": 18010, "endPinId": 19003 },

      { "id": 127, "startPinId": 19020, "endPinId": 20001 },
      { "id": 128, "startPinId": 20010, "endPinId": 21003 },
      { "id": 129, "startPinId": 19010, "endPinId": 21001 },
      { "id": 130, "startPinId": 21010, "endPinId": 10001 },

      { "id": 131, "startPinId": 22010, "endPinId": 26003 },
      { "id": 132, "startPinId": 23010, "endPinId": 26004 },
      { "id": 133, "startPinId": 24010, "endPinId": 26005 },
      { "id": 134, "startPinId": 25010, "endPinId": 26006 },

      { "id": 135, "startPinId": 26010, "endPinId": 28001 },
      { "id": 136, "startPinId": 27010, "endPinId": 28003 },
      { "id": 137, "startPinId": 28020, "endPinId": 32002 },
      { "id": 138, "startPinId": 32010, "endPinId": 33005 },

      { "id": 139, "startPinId": 26020, "endPinId": 30002 },
      { "id": 140, "startPinId": 30010, "endPinId": 29002 },
      { "id": 141, "startPinId": 29010, "endPinId": 33004 },

      { "id": 142, "startPinId": 13010, "endPinId": 31002 },
      { "id": 143, "startPinId": 31010, "endPinId": 33002 },

      { "id": 144, "startPinId": 28010, "endPinId": 33001 },
      { "id": 145, "startPinId": 33010, "endPinId": 34001 },

      { "id": 146, "startPinId": 26011, "endPinId": 35001 },
      { "id": 147, "startPinId": 26021, "endPinId": 36002 },
      { "id": 148, "startPinId": 36010, "endPinId": 35002 }
    ]
  }
}
