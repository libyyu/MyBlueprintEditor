{
  "runtime": {
    "fileType": "runtime",
    "metadata": {
      "schemaVersion": 2,
      "blueprintClass": 0,
      "name": "ToolUseAgent",
      "description": "Two-turn LLM agent with tool use (get_weather). Round 1: LLM decides to call get_weather. Round 2: LLM answers using tool result.",
      "version": "1.0.0"
    },
    "nodes": [
      {
        "id": 1,
        "definitionId": "OnBeginPlay",
        "name": "On Begin Play",
        "pins": [
          { "id": 1001, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 4,
        "definitionId": "String.Template",
        "name": "User Prompt",
        "pins": [
          { "id": 4001, "kind": 0, "dataType": 4, "name": "Template",
            "defaultValue": "What is the weather in {{location}}?" },
          { "id": 4002, "kind": 0, "dataType": 6, "name": "Keys",
            "defaultValue": ["location"] },
          { "id": 4003, "kind": 0, "dataType": 6, "name": "Values",
            "defaultValue": ["Shanghai"] },
          { "id": 4004, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },
      {
        "id": 5,
        "definitionId": "JSON.MakeMessage",
        "name": "User Message",
        "pins": [
          { "id": 5001, "kind": 0, "dataType": 4, "name": "Role",       "defaultValue": "user" },
          { "id": 5002, "kind": 0, "dataType": 4, "name": "Content" },
          { "id": 5003, "kind": 0, "dataType": 4, "name": "ToolCallId", "defaultValue": "" },
          { "id": 5004, "kind": 1, "dataType": 4, "name": "Message" }
        ]
      },
      {
        "id": 6,
        "definitionId": "JSON.ArrayPush",
        "name": "Make Messages",
        "pins": [
          { "id": 6001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 6002, "kind": 0, "dataType": 4, "name": "JSON",    "defaultValue": "[]" },
          { "id": 6003, "kind": 0, "dataType": 9, "name": "Element" },
          { "id": 6010, "kind": 1, "dataType": 0, "isExec": true },
          { "id": 6011, "kind": 1, "dataType": 4, "name": "JSON" },
          { "id": 6012, "kind": 1, "dataType": 2, "name": "Length" }
        ]
      },
      {
        "id": 2,
        "definitionId": "JSON.ArrayPush",
        "name": "Make Tools Array",
        "comment": "Wrap tool def JSON string into a tools array",
        "pins": [
          { "id": 2001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 2002, "kind": 0, "dataType": 4, "name": "JSON",    "defaultValue": "[]" },
          { "id": 2003, "kind": 0, "dataType": 9, "name": "Element",
            "defaultValue": "{\"type\":\"function\",\"function\":{\"name\":\"get_weather\",\"description\":\"Get current weather for a location\",\"parameters\":{\"type\":\"object\",\"properties\":{\"location\":{\"type\":\"string\",\"description\":\"City name\"}},\"required\":[\"location\"]}}}" },
          { "id": 2010, "kind": 1, "dataType": 0, "isExec": true },
          { "id": 2011, "kind": 1, "dataType": 4, "name": "JSON" },
          { "id": 2012, "kind": 1, "dataType": 2, "name": "Length" }
        ]
      },
      {
        "id": 7,
        "definitionId": "LLM.Chat",
        "name": "LLM Call 1",
        "pins": [
          { "id": 7001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 7002, "kind": 0, "dataType": 4, "name": "BaseURL",      "defaultValue": "https://api.openai.com/v1" },
          { "id": 7003, "kind": 0, "dataType": 4, "name": "ApiKey",       "defaultValue": "sk-your-api-key-here" },
          { "id": 7004, "kind": 0, "dataType": 4, "name": "Model",        "defaultValue": "gpt-4o" },
          { "id": 7005, "kind": 0, "dataType": 4, "name": "Messages" },
          { "id": 7006, "kind": 0, "dataType": 4, "name": "SystemPrompt", "defaultValue": "You are a helpful assistant." },
          { "id": 7007, "kind": 0, "dataType": 2, "name": "MaxTokens",    "defaultValue": 512 },
          { "id": 7008, "kind": 0, "dataType": 3, "name": "Temperature",  "defaultValue": 0.7 },
          { "id": 7009, "kind": 0, "dataType": 4, "name": "Tools" },
          { "id": 7010, "kind": 1, "dataType": 0, "name": "onReply",      "isExec": true },
          { "id": 7011, "kind": 1, "dataType": 0, "name": "onToolCall",   "isExec": true },
          { "id": 7012, "kind": 1, "dataType": 0, "name": "onError",      "isExec": true },
          { "id": 7013, "kind": 1, "dataType": 4, "name": "Reply" },
          { "id": 7014, "kind": 1, "dataType": 4, "name": "ToolCallsJSON" },
          { "id": 7015, "kind": 1, "dataType": 4, "name": "FinishReason" },
          { "id": 7016, "kind": 1, "dataType": 4, "name": "FullResponse" },
          { "id": 7017, "kind": 1, "dataType": 4, "name": "ErrorMessage" }
        ]
      },
      {
        "id": 8,
        "definitionId": "JSON.GetPath",
        "name": "Get Tool Call ID",
        "pins": [
          { "id": 8001, "kind": 0, "dataType": 4, "name": "JSON" },
          { "id": 8002, "kind": 0, "dataType": 4, "name": "Path",
            "defaultValue": "[0].id" },
          { "id": 8003, "kind": 1, "dataType": 4, "name": "Value" },
          { "id": 8004, "kind": 1, "dataType": 1, "name": "Found" }
        ]
      },
      {
        "id": 9,
        "definitionId": "JSON.GetPath",
        "name": "Get Location Arg",
        "pins": [
          { "id": 9001, "kind": 0, "dataType": 4, "name": "JSON" },
          { "id": 9002, "kind": 0, "dataType": 4, "name": "Path",
            "defaultValue": "[0].function.arguments.location" },
          { "id": 9003, "kind": 1, "dataType": 4, "name": "Value" },
          { "id": 9004, "kind": 1, "dataType": 1, "name": "Found" }
        ]
      },
      {
        "id": 10,
        "definitionId": "Branch",
        "name": "Has Tool Call?",
        "pins": [
          { "id": 10001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 10002, "kind": 0, "dataType": 1, "name": "Condition" },
          { "id": 10003, "kind": 1, "dataType": 0, "name": "True",  "isExec": true },
          { "id": 10004, "kind": 1, "dataType": 0, "name": "False", "isExec": true }
        ]
      },
      {
        "id": 11,
        "definitionId": "FormatString",
        "name": "Weather Result",
        "pins": [
          { "id": 11001, "kind": 0, "dataType": 4, "name": "Format",
            "defaultValue": "Weather in {city}: Sunny, 25°C" },
          { "id": 11002, "kind": 0, "dataType": 4, "name": "city" },
          { "id": 11003, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },
      {
        "id": 12,
        "definitionId": "JSON.MakeMessage",
        "name": "Tool Message",
        "pins": [
          { "id": 12001, "kind": 0, "dataType": 4, "name": "Role",       "defaultValue": "tool" },
          { "id": 12002, "kind": 0, "dataType": 4, "name": "Content" },
          { "id": 12003, "kind": 0, "dataType": 4, "name": "ToolCallId" },
          { "id": 12004, "kind": 1, "dataType": 4, "name": "Message" }
        ]
      },
      {
        "id": 13,
        "definitionId": "JSON.ArrayPush",
        "name": "Append Tool Msg",
        "pins": [
          { "id": 13001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 13002, "kind": 0, "dataType": 4, "name": "JSON" },
          { "id": 13003, "kind": 0, "dataType": 9, "name": "Element" },
          { "id": 13010, "kind": 1, "dataType": 0, "isExec": true },
          { "id": 13011, "kind": 1, "dataType": 4, "name": "JSON" },
          { "id": 13012, "kind": 1, "dataType": 2, "name": "Length" }
        ]
      },
      {
        "id": 14,
        "definitionId": "LLM.Chat",
        "name": "LLM Call 2",
        "pins": [
          { "id": 14001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 14002, "kind": 0, "dataType": 4, "name": "BaseURL",      "defaultValue": "https://api.openai.com/v1" },
          { "id": 14003, "kind": 0, "dataType": 4, "name": "ApiKey",       "defaultValue": "sk-your-api-key-here" },
          { "id": 14004, "kind": 0, "dataType": 4, "name": "Model",        "defaultValue": "gpt-4o" },
          { "id": 14005, "kind": 0, "dataType": 4, "name": "Messages" },
          { "id": 14006, "kind": 0, "dataType": 4, "name": "SystemPrompt", "defaultValue": "You are a helpful assistant." },
          { "id": 14007, "kind": 0, "dataType": 2, "name": "MaxTokens",    "defaultValue": 512 },
          { "id": 14008, "kind": 0, "dataType": 3, "name": "Temperature",  "defaultValue": 0.7 },
          { "id": 14009, "kind": 0, "dataType": 4, "name": "Tools",        "defaultValue": "" },
          { "id": 14010, "kind": 1, "dataType": 0, "name": "onReply",      "isExec": true },
          { "id": 14011, "kind": 1, "dataType": 0, "name": "onToolCall",   "isExec": true },
          { "id": 14012, "kind": 1, "dataType": 0, "name": "onError",      "isExec": true },
          { "id": 14013, "kind": 1, "dataType": 4, "name": "Reply" },
