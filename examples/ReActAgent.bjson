{
  "runtime": {
    "fileType": "runtime",
    "metadata": {
      "schemaVersion": 2,
      "blueprintClass": 0,
      "name": "ReActAgent",
      "description": "ReAct Agent loop using FireEvent/CustomEventNode to break the exec cycle. BeginPlay -> push user msg -> save -> FireEvent('AgentLoop') -> [next frame] CustomEventNode('AgentLoop') -> LLM Call -> onToolCall -> process tools -> update messages -> FireEvent('AgentLoop') -> [loop]. Exits via onReply.",
      "version": "1.0"
    },
    "nodes": [
      {
        "id": 1,
        "definitionId": "OnBeginPlay",
        "definitionVersion": 1,
        "name": "On Begin Play",
        "pins": [
          { "id": 2, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 153,
        "definitionId": "JSON.MakeMessage",
        "definitionVersion": 1,
        "name": "Make User Message",
        "pins": [
          { "id": 154, "kind": 0, "dataType": 4, "name": "Role",       "defaultValue": "user" },
          { "id": 155, "kind": 0, "dataType": 4, "name": "Content",    "defaultValue": "What's the weather in Beijing and Shanghai today?" },
          { "id": 156, "kind": 0, "dataType": 4, "name": "ToolCallId", "defaultValue": "" },
          { "id": 157, "kind": 1, "dataType": 4, "name": "Message" }
        ]
      },
      {
        "id": 9,
        "definitionId": "JSON.ArrayPush",
        "definitionVersion": 1,
        "name": "Push User Msg",
        "pins": [
          { "id": 10,  "kind": 0, "dataType": 0, "isExec": true },
          { "id": 11,  "kind": 0, "dataType": 4, "name": "JSON",    "defaultValue": "[]" },
          { "id": 12,  "kind": 0, "dataType": 9, "name": "Element" },
          { "id": 13,  "kind": 1, "dataType": 0, "isExec": true },
          { "id": 14,  "kind": 1, "dataType": 4, "name": "JSON" },
          { "id": 15,  "kind": 1, "dataType": 2, "name": "Length" }
        ]
      },
      {
        "id": 16,
        "definitionId": "SetVariable",
        "definitionVersion": 1,
        "name": "Save messages",
        "pins": [
          { "id": 17, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 18, "kind": 0, "dataType": 4, "name": "Name",  "defaultValue": "messages" },
          { "id": 19, "kind": 0, "dataType": 4, "name": "Value" },
          { "id": 20, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 21,
        "definitionId": "FireEvent",
        "definitionVersion": 1,
        "name": "Start Agent Loop",
        "pins": [
          { "id": 22, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 23, "kind": 0, "dataType": 4, "name": "EventName", "defaultValue": "AgentLoop" },
          { "id": 24, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 25,
        "definitionId": "CustomEventNode",
        "definitionVersion": 1,
        "name": "AgentLoop",
        "nodeData": { "EventName": "AgentLoop" },
        "pins": [
          { "id": 27, "kind": 1, "dataType": 0, "isExec": true },
          { "id": 26, "kind": 1, "dataType": 4, "name": "EventName" }
        ]
      },
      {
        "id": 28,
        "definitionId": "GetVariable",
        "definitionVersion": 1,
        "name": "Get messages",
        "pins": [
          { "id": 29, "kind": 0, "dataType": 4, "name": "Name",  "defaultValue": "messages" },
          { "id": 30, "kind": 1, "dataType": 4, "name": "Value" }
        ]
      },
      {
        "id": 31,
        "definitionId": "LLM.Chat",
        "definitionVersion": 1,
        "name": "LLM Call",
        "pins": [
          { "id": 32, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 33, "kind": 0, "dataType": 4, "name": "BaseURL",      "defaultValue": "https://api.openai.com/v1" },
          { "id": 34, "kind": 0, "dataType": 4, "name": "ApiKey",       "defaultValue": "sk-your-api-key-here" },
          { "id": 35, "kind": 0, "dataType": 4, "name": "Model",        "defaultValue": "gpt-4o" },
          { "id": 36, "kind": 0, "dataType": 4, "name": "Messages",     "defaultValue": "" },
          { "id": 37, "kind": 0, "dataType": 4, "name": "SystemPrompt", "defaultValue": "You are a helpful assistant with access to weather tools." },
          { "id": 38, "kind": 0, "dataType": 2, "name": "MaxTokens",    "defaultValue": 1024 },
          { "id": 39, "kind": 0, "dataType": 3, "name": "Temperature",  "defaultValue": 0.7 },
          { "id": 40, "kind": 0, "dataType": 4, "name": "Tools",
