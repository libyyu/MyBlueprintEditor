          { "id": 41, "kind": 1, "dataType": 0, "name": "onReply",      "isExec": true },
          { "id": 42, "kind": 1, "dataType": 0, "name": "onToolCall",   "isExec": true },
          { "id": 43, "kind": 1, "dataType": 0, "name": "onError",      "isExec": true },
          { "id": 44, "kind": 1, "dataType": 4, "name": "Reply" },
