{
  "runtime": {
    "fileType": "blueprint",
    "metadata": {
      "name": "ReActAgent",
      "version": "2.0.0",
      "description": "ReAct-style agent with parallel tool calls. Uses FireEvent + CustomEventNode for async loop (no exec cycle). Supports multiple tool calls per round via Tool.ForEach + Tool.Match. Edit ApiKey/BaseURL/Model before running.",
      "blueprintClass": "Normal"
    },
