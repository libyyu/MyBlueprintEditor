{
  "runtime": {
    "fileType": "runtime",
    "metadata": {
      "schemaVersion": 2,
      "blueprintClass": 0,
      "name": "AgentDemo",
      "description": "Multi-turn LLM Agent: system prompt + user question → LLM.Chat → print reply",
      "version": "1.0"
    },
    "nodes": [
      {
        "id": 1,
        "definitionId": "OnBeginPlay",
        "name": "On Begin Play",
        "pins": [
          { "id": 2, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 10,
        "definitionId": "String.Template",
        "name": "Build User Prompt",
        "comment": "Render {{topic}} into a user question",
        "pins": [
          { "id": 11, "kind": 0, "dataType": 4, "name": "Template",
            "defaultValue": "请用简洁的语言解释：{{topic}}。回答限制在100字以内。" },
          { "id": 12, "kind": 0, "dataType": 6, "name": "Keys",
            "defaultValue": ["topic"] },
          { "id": 13, "kind": 0, "dataType": 6, "name": "Values",
            "defaultValue": ["什么是大型语言模型（LLM）"] },
          { "id": 14, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },
      {
        "id": 20,
        "definitionId": "JSON.MakeMessage",
        "name": "Make User Message",
        "comment": "Wrap prompt as {role:user, content:...}",
        "pins": [
          { "id": 21, "kind": 0, "dataType": 4, "name": "Role",    "defaultValue": "user" },
          { "id": 22, "kind": 0, "dataType": 4, "name": "Content", "defaultValue": "" },
          { "id": 23, "kind": 0, "dataType": 4, "name": "ToolCallId", "defaultValue": "" },
          { "id": 24, "kind": 1, "dataType": 4, "name": "Message" }
        ]
      },
      {
        "id": 30,
        "definitionId": "JSON.ArrayPush",
        "name": "Push to Messages",
        "comment": "messages = [] + user message",
        "pins": [
          { "id": 300, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 31, "kind": 0, "dataType": 4, "name": "JSON",    "defaultValue": "[]" },
          { "id": 32, "kind": 0, "dataType": 9, "name": "Element" },
          { "id": 33, "kind": 1, "dataType": 0, "isExec": true },
          { "id": 34, "kind": 1, "dataType": 4, "name": "JSON" },
          { "id": 35, "kind": 1, "dataType": 2, "name": "Length" }
        ]
      },
      {
        "id": 40,
        "definitionId": "LLM.Chat",
        "name": "LLM Chat",
        "comment": "Call OpenAI-compatible API",
        "pins": [
          { "id": 400, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 41, "kind": 0, "dataType": 4, "name": "BaseURL",
            "defaultValue": "https://api.openai.com/v1" },
          { "id": 42, "kind": 0, "dataType": 4, "name": "ApiKey",
            "defaultValue": "sk-your-api-key-here" },
          { "id": 43, "kind": 0, "dataType": 4, "name": "Model",
            "defaultValue": "gpt-4o" },
          { "id": 44, "kind": 0, "dataType": 4, "name": "Messages",   "defaultValue": "[]" },
          { "id": 45, "kind": 0, "dataType": 4, "name": "SystemPrompt",
            "defaultValue": "你是一个专业的AI助手，回答简洁准确。" },
          { "id": 46, "kind": 0, "dataType": 2, "name": "MaxTokens",  "defaultValue": 256 },
          { "id": 47, "kind": 0, "dataType": 3, "name": "Temperature","defaultValue": 0.7 },
          { "id": 4700, "kind": 0, "dataType": 4, "name": "Tools", "defaultValue": "" },
          { "id": 48, "kind": 1, "dataType": 0, "name": "onReply",    "isExec": true },
          { "id": 4801, "kind": 1, "dataType": 0, "name": "onToolCall","isExec": true },
          { "id": 49, "kind": 1, "dataType": 0, "name": "onError",    "isExec": true },
          { "id": 50, "kind": 1, "dataType": 4, "name": "Reply" },
          { "id": 4901, "kind": 1, "dataType": 4, "name": "ToolCallsJSON" },
          { "id": 4902, "kind": 1, "dataType": 4, "name": "FinishReason" },
          { "id": 51, "kind": 1, "dataType": 4, "name": "FullResponse" },
          { "id": 52, "kind": 1, "dataType": 4, "name": "ErrorMessage" }
        ]
      },
      {
        "id": 60,
        "definitionId": "PrintString",
        "name": "Print Reply",
        "comment": "Print LLM reply to console",
        "pins": [
          { "id": 600, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 61, "kind": 0, "dataType": 4, "name": "In String", "defaultValue": "" },
          { "id": 62, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 70,
        "definitionId": "FormatString",
        "name": "Format Reply Log",
        "comment": "Prefix reply with [AI] label",
        "pins": [
          { "id": 71, "kind": 0, "dataType": 4, "name": "Format",
            "defaultValue": "[AI] {reply}" },
          { "id": 72, "kind": 0, "dataType": 4, "name": "reply", "defaultValue": "" },
          { "id": 73, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },
      {
        "id": 80,
        "definitionId": "FormatString",
        "name": "Format Error Log",
        "comment": "Prefix error with [ERR] label",
        "pins": [
          { "id": 81, "kind": 0, "dataType": 4, "name": "Format",
            "defaultValue": "[ERR] {err}" },
          { "id": 82, "kind": 0, "dataType": 4, "name": "err", "defaultValue": "" },
          { "id": 83, "kind": 1, "dataType": 4, "name": "Result" }
        ]
      },
      {
        "id": 90,
        "definitionId": "PrintString",
        "name": "Print Error",
        "comment": "Print error message",
        "pins": [
          { "id": 900, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 91, "kind": 0, "dataType": 4, "name": "In String", "defaultValue": "" },
          { "id": 92, "kind": 1, "dataType": 0, "isExec": true }
        ]
      }
    ],
