    "metadata": {
      "name": "MultiTurnAgent",
      "version": "1.0.0",
      "description": "ReAct-style multi-turn LLM agent with tool use loop. Uses WhileLoop + Tool.ForEach + Tool.Match. Runs up to 5 rounds; exits when LLM replies without tool_calls.",
      "blueprintClass": "Normal"
    },
