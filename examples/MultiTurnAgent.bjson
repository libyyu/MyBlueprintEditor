{
  "runtime": {
    "fileType": "runtime",
    "metadata": {
      "schemaVersion": 2,
      "blueprintClass": 0,
      "name": "MultiTurnAgent",
      "description": "ReAct-style multi-turn LLM agent with tool use loop. Uses WhileLoop + Tool.ForEach + Tool.Match. Runs up to 5 rounds; exits when LLM replies without tool_calls.",
      "version": "1.0.0"
    },
    "nodes": [
      {
        "id": 1,
        "definitionId": "OnBeginPlay",
        "name": "On Begin Play",
        "pins": [
          { "id": 1001, "kind": 1, "dataType": 0, "isExec": true }
        ]
      },
      {
        "id": 2,
        "definitionId": "SetVariable",
        "name": "Init messages",
        "pins": [
          { "id": 2001, "kind": 0, "dataType": 0, "isExec": true },
          { "id": 2002, "kind": 0, "dataType": 4, "name": "Name",  "defaultValue": "messages" },
