<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!--
        UITest.uxml — UI Toolkit 框架测试面板
        测试目标：
          1. 精确绑定按钮点击 (RegisterClick)
          2. 全局扫描模式 (OnClick by name)
          3. 文字设置 (SetText / GetText)
          4. 显隐控制 (SetDisplay)
          5. 深度/层级 (sortingOrder)
    -->
    <ui:VisualElement name="root" style="
        width: 600px; height: 800px;
        background-color: rgba(20,20,30,0.92);
        border-radius: 16px;
        padding: 32px;
        position: absolute; left: 50%; top: 50%;
        translate: -50% -50%;
        flex-direction: column;
        align-items: center;
    ">
        <!-- 标题 -->
        <ui:Label name="lbl_title" text="UI Toolkit Test Panel" style="
            font-size: 28px;
            color: white;
            margin-bottom: 24px;
            -unity-font-style: bold;
        "/>

        <!-- 状态输出 -->
        <ui:Label name="lbl_status" text="status: ready" style="
            font-size: 18px;
            color: rgb(180,220,180);
            margin-bottom: 32px;
            width: 100%;
            white-space: normal;
            -unity-text-align: upper-center;
        "/>

        <!-- 测试按钮组 -->
        <ui:VisualElement name="btn_group" style="
            flex-direction: column;
            width: 100%;
            align-items: center;
        ">
            <ui:Button name="btn_test_text"    text="① SetText 测试"    style="width:320px; height:56px; font-size:18px; margin-bottom:12px;"/>
            <ui:Button name="btn_test_display" text="② SetDisplay 切换"  style="width:320px; height:56px; font-size:18px; margin-bottom:12px;"/>
            <ui:Button name="btn_test_gettext" text="③ GetText 读取"     style="width:320px; height:56px; font-size:18px; margin-bottom:12px;"/>
            <ui:Button name="btn_test_class"   text="④ AddClass 测试"    style="width:320px; height:56px; font-size:18px; margin-bottom:12px;"/>
        </ui:VisualElement>

        <!-- 可切换显隐的测试元素 -->
        <ui:Label name="lbl_toggle_target" text="★ 这个文字可以被隐藏 ★" style="
            font-size:20px; color: yellow;
            margin-top: 20px; margin-bottom: 20px;
        "/>

        <!-- 关闭按钮 -->
        <ui:Button name="btn_close" text="关闭" style="
            width:200px; height:52px;
            font-size:20px;
            margin-top: auto;
            background-color: rgb(180,60,60);
            color: white;
        "/>
    </ui:VisualElement>
</ui:UXML>
